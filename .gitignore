# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Xcode build artifacts and per-user state
build/
DerivedData/
**/xcuserdata/
*.xcuserstate
*.xcuserdatad/
*.moved-aside
*.swp
*.swo

# Swift Package Manager
.swiftpm/
.build/
Packages/
Package.pins
Package.resolved

# Local artifacts
*.pem
*.p8
*.p12
*.cer
*.mobileprovision
*-credentials*
.env
.env.*
*.token
secrets.json

# Screenshots — useful as scratch on disk, not source of truth.
# (Reintroduce specific ones to git as needed by overriding here.)
Docs/Screenshots/

# Generated App Store screenshots — produced by scripts/capture_screenshots.sh.
# These are build artifacts; only the script that produces them is tracked.
Docs/AppStoreScreenshots/

# Editor / OS junk
*.log
*~
.idea/
.vscode/

# Local screen recordings (kept on disk, not version controlled)
Docs/ScreenRecording*
*.mp4
